#!/bin/sh
# fm-title — reads a prompt on stdin and prints a short title, generated on-device (see
# herdr_fm_title/title.py). Exit 1 means no title.
#
# The bin/ entry points stay sh: Python exits 2 when it can't run a file, and Claude reads a
# prompt hook's exit 2 as "block this prompt". The interpreter is the one install pinned in
# ../python; HERDR_FM_TITLE_PYTHON overrides it.
root=$(cd "$(dirname "$0")/.." && pwd -P)
py=${HERDR_FM_TITLE_PYTHON:-}
[ -n "$py" ] || read -r py 2>/dev/null <"$root/python"
[ -n "$py" ] || py=$(command -v python3)
[ -x "$py" ] && [ -f "$root/main.py" ] || exit 1
exec "$py" -I -S -X pycache_prefix="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-fm-title/pycache" "$root/main.py" fm-title "$@"
